# Catalog: demo | postgres | vertica | multi
DPMCP_MODE=demo

# Operations: demo | airflow
DPMCP_OPERATIONS_MODE=demo

# ETL log search: demo | opensearch | loki
DPMCP_LOGS_MODE=demo

# MCP transport: stdio | streamable-http
DPMCP_TRANSPORT=streamable-http
DPMCP_HOST=0.0.0.0
DPMCP_PORT=8000
DPMCP_LOG_LEVEL=INFO
DPMCP_MAX_ROWS=100

# PostgreSQL catalog adapter
# DPMCP_POSTGRES_DSN=postgresql://readonly_user:change-me@postgres:5432/analytics
DPMCP_POSTGRES_STATEMENT_TIMEOUT_MS=5000

# Vertica catalog adapter (official vertica-python client)
# DPMCP_VERTICA_DSN=vertica://readonly_user:change-me@vertica:5433/analytics?tlsmode=verify-full
DPMCP_VERTICA_SOURCE_NAME=vertica
DPMCP_VERTICA_CONNECTION_TIMEOUT_SECONDS=10
DPMCP_VERTICA_SESSION_LABEL=data-platform-mcp

# Airflow 3 public REST API (/api/v2)
# DPMCP_AIRFLOW_BASE_URL=https://airflow.example.internal
# DPMCP_AIRFLOW_TOKEN=replace-me
DPMCP_AIRFLOW_TIMEOUT_SECONDS=10

# OpenSearch log backend
# DPMCP_OPENSEARCH_URL=https://opensearch.example.internal
DPMCP_OPENSEARCH_INDEX=etl-logs-*
# DPMCP_OPENSEARCH_USERNAME=readonly_user
# DPMCP_OPENSEARCH_PASSWORD=replace-me
# DPMCP_OPENSEARCH_TOKEN=replace-me

# Loki log backend
# DPMCP_LOKI_URL=https://loki.example.internal
# DPMCP_LOKI_TOKEN=replace-me
DPMCP_LOKI_QUERY={job=~".+"} |= "{query}"

# MCP bearer authentication / RBAC (Streamable HTTP only)
DPMCP_AUTH_ENABLED=false
DPMCP_AUTH_ISSUER_URL=https://auth.example.com
DPMCP_AUTH_RESOURCE_URL=http://127.0.0.1:8000/mcp
# JSON map: token -> {"client_id": "...", "role": "reader|analyst|operator|admin"}
# DPMCP_API_TOKENS_JSON={"replace-me":{"client_id":"catalog-agent","role":"reader"}}

# Audit JSONL
DPMCP_AUDIT_ENABLED=true
# DPMCP_AUDIT_LOG_PATH=/var/log/data-platform-mcp/audit.jsonl
